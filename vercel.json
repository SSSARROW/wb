{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/portfolio", "destination": "/work", "permanent": true },
    { "source": "/services/ai-solutions", "destination": "/services/ai-development", "permanent": true },
    { "source": "/services/web-apps", "destination": "/services/web-app-development", "permanent": true },
    { "source": "/services/mobile-apps", "destination": "/services/mobile-app-development", "permanent": true },
    { "source": "/services/software-development", "destination": "/services/custom-software-development", "permanent": true },
    { "source": "/services/uiux-design", "destination": "/services/ui-ux-design", "permanent": true }
  ],
  "rewrites": [
    { "source": "/careers/:slug/apply", "destination": "/careers/role.html" },
    { "source": "/careers/:slug", "destination": "/careers/role.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/careers/(.*)/apply", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
